# Required
GROQ_API_KEY=
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/leanlm

# Optional — set one or more to enable those providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional — used by Embedder (sentence-transformers) for Hugging Face models
HF_TOKEN=

# BYOK encryption secret
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_KEY_ENCRYPTION_SECRET=

# Optional — override defaults (currently hardcoded to llama-3.1-8b-instant)
CLASSIFY_MODEL=
SUMMARIZER_MODEL=

# Provider key fallback
# Set false in production when BYOK keys are required.
ALLOW_ENV_PROVIDER_FALLBACK=true

# Supabase Auth
# Required for authenticated endpoints
SUPABASE_URL=
# Optional — derived from SUPABASE_URL if not set
SUPABASE_JWT_ISSUER=
# Optional — derived from SUPABASE_JWT_ISSUER if not set
SUPABASE_JWKS_URL=
