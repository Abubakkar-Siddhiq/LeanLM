# Required
GROQ_API_KEY=
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/routiq

# Optional — set one or more to enable those providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional — used by Embedder (sentence-transformers) for Hugging Face models
HF_TOKEN=

# Optional — override defaults (currently hardcoded to llama-3.1-8b-instant)
CLASSIFY_MODEL=
SUMMARIZER_MODEL=
